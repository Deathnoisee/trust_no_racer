    - target: {fileID: 8021706265186088782, guid: a21a9ca0325425f42ae2532455c4dfb6, type: 3}
      propertyPath: m_LocalEulerAnglesHint.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8021706265186088782, guid: a21a9ca0325425f42ae2532455c4dfb6, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8021706265186088782, guid: a21a9ca0325425f42ae2532455c4dfb6, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8099463261135127859, guid: a21a9ca0325425f42ae2532455c4dfb6, type: 3}
      propertyPath: m_text
      value: 'The municipal swimming grounds were crowded yesterday as competitors
        from across the county gathered for the annual summer swimming meeting.

        The
        afternoon''s most impressive performance came from young swimmer Eleanor
        Hayes, who won the principal race after taking an early lead and maintaining
        it until the final stroke.

        Several competitors attempted to challenge
        Hayes during the middle portion of the race, but her powerful finish proved
        decisive. Spectators applauded enthusiastically as she touched the wall and
        received the winner''s medal.

        Training officials believe that Hayes
        has considerable potential and may soon compete in larger regional events.'
      objectReference: {fileID: 0}
    - target: {fileID: 8551431192672133126, guid: a21a9ca0325425f42ae2532455c4dfb6, type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 3217220511709456641, guid: a1cb8375d1996af439cecb04e2939600, type: 3}
    - target: {fileID: 8623385484294536488, guid: a21a9ca0325425f42ae2532455c4dfb6, type: 3}
      propertyPath: m_text
      value: "A well-known racing trainer could not be located following yesterday's
        controversial event. His disappearance occurred shortly after one of his
        athletes produced an unexpectedly fast time.\nOfficials have requested that
        the trainer return for questioning. His colleagues insist that there is a
        perfectly reasonable explanation and that he is \u201Cprobably just taking
        a short holiday.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8623385484294536488, guid: a21a9ca0325425f42ae2532455c4dfb6, type: 3}
      propertyPath: m_margin.w
      value: 4.2026978
      objectReference: {fileID: 0}
    - target: {fileID: 8623385484294536488, guid: a21a9ca0325425f42ae2532455c4dfb6, type: 3}
      propertyPath: m_margin.z
      value: 0.23266602
      objectReference: {fileID: 0}
