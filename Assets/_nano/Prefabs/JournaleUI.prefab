  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'A packed hall witnessed an exciting evening of boxing last Saturday as
    young challenger Arthur Bell defeated veteran fighter Samuel Crane after a hard-fought
    contest.

    Bell entered the ring with considerable confidence, relying on
    quick footwork and a steady series of combinations. Crane, meanwhile, used his
    experience to withstand the early pressure and repeatedly forced his opponent
    against the ropes.

    The decisive moment came during the final round, when
    Bell landed a clean series of punches that left the judges with little doubt.
    The crowd responded with a tremendous cheer as the young fighter was declared
    the winner.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
  m_sharedMaterial: {fileID: 2147374, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
