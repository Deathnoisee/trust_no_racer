--- !u!114 &2659459170781084179
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7853451011251691453}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "What began as an ordinary afternoon of competition has quickly become
    the subject of the most talked-about scandal in recent racing history. Hundreds
    of spectators gathered along the course expecting to witness a fair and honorable
    contest between the finest runners in the region. Instead, they were met with
    an extraordinary display of cunning, confusion, and what officials are now calling
    a \u201Cdeliberate violation of the course.\nAccording to several witnesses,
    the leading runner appeared to abandon the marked route during the most critical
    portion of the race. Rather than following the official path, he suddenly turned
    away from the course and disappeared behind a nearby bend. Moments later, he
    was seen far ahead of his competitors, having seemingly gained a considerable
    advantage."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
  m_sharedMaterial: {fileID: 2147374, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
